      "attachments": {
        "label": "Photo, bon de livraison ou document",
        "help": "Photo, bon de livraison, réclamation ou document… JPG, PNG, WEBP ou PDF. 5 Mo max, 3 fichiers max.",
        "accept": ".pdf,.jpg,.jpeg,.png,.webp",
        "maxFiles": 3,
        "maxSizeMb": 5
      }
